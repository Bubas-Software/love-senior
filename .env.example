# Operational Love Sênior configuration. Copy to .env.local and keep secrets
# out of version control.
LOVE_SENIOR_SAFE_PREVIEW=false
LOVE_SENIOR_AUTH_PROVIDER=supabase
LOVE_SENIOR_DATA_PROVIDER=supabase
LOVE_SENIOR_STORAGE_PROVIDER=supabase
LOVE_SENIOR_CONTRACT_DIRECT_UPLOAD=false

# Project URL supplied for this clone. These values are public configuration.
SUPABASE_URL=https://igbuurshmqrnpgpnyusa.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://igbuurshmqrnpgpnyusa.supabase.co

# Publishable key for the Love Sênior Supabase project. The legacy anon name
# is supported only as a fallback; never use a secret or service-role key in
# NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BfqoO9k703vK610mq_LVrw_jttFx1aM
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database key; configure later outside version control.
# Choose one key name only. Never expose it to a browser bundle.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# First Love Sênior administrator account provisioning.
SUPABASE_PROVISION_EMAIL=
SUPABASE_PROVISION_NAME=
SUPABASE_PROVISION_PASSWORD=
SUPABASE_PROVISION_ROLE=admin
SUPABASE_PROVISION_PHONE=
SUPABASE_PROVISION_RESET_PASSWORD=false

# Configure the official host and contact details before public intake is enabled.
LOVE_SENIOR_APP_URL=
LOVE_SENIOR_WHATSAPP_PHONE=
LOVE_SENIOR_EMAIL_FROM=
LOVE_SENIOR_NOTIFICATION_EMAIL=
RESEND_API_KEY=
CRON_SECRET=

# Enable Turnstile before accepting public submissions on a public host.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
LOVE_SENIOR_TURNSTILE_REQUIRED=false

# Optional, currently disabled until the Love Sênior tracking setup is confirmed.
NEXT_PUBLIC_LOVE_SENIOR_GOOGLE_ADS_ID=

# Required only for legacy sessions and recovery flows. Never commit this value.
LOVE_SENIOR_SESSION_SECRET=
LOVE_SENIOR_BOOTSTRAP_ADMIN_EMAIL=
LOVE_SENIOR_BOOTSTRAP_ADMIN_PASSWORD=
LOVE_SENIOR_BOOTSTRAP_ADMIN_NAME=
LOVE_SENIOR_BOOTSTRAP_ADMIN_PHONE=
LOVE_SENIOR_ADMIN_RECOVERY_EMAIL=
LOVE_SENIOR_ADMIN_RECOVERY_PASSWORD=
